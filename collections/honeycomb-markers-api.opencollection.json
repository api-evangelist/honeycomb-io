              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a Marker in the specified dataset. To create an environment marker, use the `__all__` keyword and an API key associated with the desired environment.\n"
        },
        {
          "info": {
            "name": "Update a Marker",
            "type": "http"
