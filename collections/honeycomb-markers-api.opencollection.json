              },
              {
                "name": "markerId",
                "value": "",
                "type": "path",
                "description": "The unique identifier (ID) of a Marker."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a Marker in the specified dataset. To update an environment marker, use the `__all__` keyword and an API key associated with the desired environment.\n"
