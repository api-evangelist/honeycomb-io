{
  "item": [
    {
      "id": "1cc4d321-59af-4bf5-8470-befb963216e5",
      "name": "Service Maps",
      "description": {
        "content": "The Service Maps API endpoints allow you to visualize the relationships between your services in Honeycomb.\n\nThis API allows you to create and retrieve service Dependency Requests, which are used to generate maps of dependencies between services.\n\n## Authorization\n\nThe API key must have the **Read Service Maps** permission. Learn more about [API keys here](https://docs.honeycomb.io/configure/environments/manage-api-keys/).\n",
        "type": "text/plain"
      },
      "item": [
