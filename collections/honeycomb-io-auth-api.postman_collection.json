  "item": [
    {
      "id": "0290e5d8-d248-4573-a0a3-da1b2b71bc85",
      "name": "Auth",
      "description": {
        "content": "API Keys have various scopes permissions and belong to a specific Team or Environment.\n\nAny valid Honeycomb ingest or configuration API Key will work with this endpoint. Learn more about [API keys](https://docs.honeycomb.io/get-started/best-practices/api-keys).\n\nThese endpoints can be used to validate authentication for a key, to determine what authorizations have been granted\nto a key, and to determine the Team and Environment that a key belongs to.\n",
        "type": "text/plain"
      },
      "item": [
