  "item": [
    {
      "id": "a3341e7b-4721-4f79-9095-6f444be1f49c",
      "name": "Reporting",
      "description": {
        "content": "The Reporting API provides access to historical performance data.\n\n## Authorization\n\nThe API key must have the **Manage SLOs** permission. Learn more about [API keys here](https://docs.honeycomb.io/configure/environments/manage-api-keys/).\n",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "e8c71cf2-d25c-497a-a589-78aee762dd44",
          "name": "Get SLO History",
          "request": {
            "name": "Get SLO History",
            "description": {
              "content": "Get a weekly breakdown of historical data for a list of SLOs for a given time range.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "1",
                "reporting",
                "slos",
                "historical"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ids\": \"<array>\",\n  \"start_time\": \"<integer>\",\n  \"end_time\": \"<integer>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "1e5cf7c1-31eb-4385-8769-550634721384",
              "name": "A mapping from SLO IDs (e.g., \"2LBq9LckbcA\") to their historical data. Each SLO ID maps to an array of compliance and budget intervals.\n\n **Note**: An empty array indicates that no historical data was found for the given time range for that SLO.\n",
              "originalRequest": {
                "url": {
                  "path": [
                    "1",
                    "reporting",
                    "slos",
                    "historical"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": []
                },
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"ids\": [\n    \"2LBq9LckbcA\",\n    \"CzcpPs7cJ4d\"\n  ],\n  \"start_time\": 1742230800,\n  \"end_time\": 1745254800\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "disabled": false,
                  "description": "The (draft07) recommended header from the IETF on rate limiting.\nThe value of the header is formatted \"limit=X, remaining=Y, reset=Z\".\nWhere:\n  - X is the maximum number of requests allowed in the window\n  - Y is the number of requests remaining in the window\n  - Z is the number of seconds until the limit resets\n",
                  "key": "Ratelimit",
                  "value": "limit=100, remaining=50, reset=60"
                },
                {
                  "disabled": false,
                  "description": "The (draft07) recommended header from the IETF on rate limiting.\nThe value of the header is formatted \"X;w=Y\".\nWhere:\n - X is the maximum number of requests allowed in a window\n - Y is the size of the window in seconds\n",
                  "key": "RateLimitPolicy",
                  "value": "100;w=60"
                },
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"2LBq9LckbcA\": [\n    {\n      \"timestamp\": 1744650000,\n      \"compliance\": 91.44851657940663,\n      \"budget_remaining\": 14.48516579406632\n    },\n    {\n      \"timestamp\": 1744653600,\n      \"compliance\": 97.98746514671242,\n      \"budget_remaining\": 88.13453467953423\n    }\n  ],\n  \"CzcpPs7cJ4d\": [\n    {\n      \"timestamp\": 1744650000,\n      \"compliance\": 93.53414567784128,\n      \"budget_remaining\": -71.02966841186735\n    }\n  ]\n}",
