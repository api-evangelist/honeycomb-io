  "item": [
    {
      "id": "530d903a-d27f-4dc2-82f2-380d37f3653a",
      "name": "Marker Settings",
      "description": {
        "content": "Marker Settings apply to groups of similar Markers.\nFor example, \"deploys\" markers appear with the same color on a graph.\n\nThis API allows you to list, create, update, and delete Marker Settings.\n\n## Authorization\n\nThe API key must have the **Manage Markers** permission. Learn more about [API keys here](https://docs.honeycomb.io/configure/environments/manage-api-keys/).\n",
        "type": "text/plain"
      },
