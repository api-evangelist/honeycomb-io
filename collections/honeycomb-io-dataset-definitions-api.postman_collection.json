          "request": {
            "name": "Set or Update Dataset Definitions",
            "description": {
              "content": "Set or update one or more definitions for a Dataset.\n**Note**: While the PATCH payload can include the `column_type`, Honeycomb does not use this field when updating Dataset Definitions.\n",
